# Copy to .env and adjust. Never commit real secrets.

# --- Database (docker compose publishes Postgres on this host port) ---
POSTGRES_PASSWORD=talentscope
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://talentscope:talentscope@localhost:5433/talentscope
# Used only by the backend test suite; the database is created automatically.
TEST_DATABASE_URL=postgresql+psycopg://talentscope:talentscope@localhost:5433/talentscope_test

# --- API ---
API_PORT=8010
CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=INFO
# "text" for local development, "json" for containers/log shippers.
LOG_FORMAT=text
# Records not observed within this many days are labelled "not seen recently".
FRESHNESS_WINDOW_DAYS=30

# Admin API is disabled unless a token is set. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

# Identifies TalentScope to sources when an approved connector makes requests.
CRAWLER_CONTACT_URL=https://github.com/ReynoBenedict/job-market-anlysis-ABD

# --- Data lake (bronze/silver/gold Parquet; git-ignored) ---
LAKE_DIR=./lake

# --- Web (Next.js) ---
WEB_PORT=3001
API_BASE_URL=http://localhost:8010
# Basic-auth credentials for the /admin pages. Admin pages are disabled when unset.
ADMIN_USERNAME=
ADMIN_PASSWORD=
